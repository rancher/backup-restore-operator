#!/bin/bash
set -e

source "$(dirname "$0")/version"
cd "$(dirname "$0")/.."
mkdir -p {dist,build}/artifacts

IMAGE="${REPO}/backup-restore-operator:${TAG}"
DOCKERFILE=./package/Dockerfile
BUILDX_INSTANCE=rancher

if [[ ${DOCKER_BUILDX} -eq 1 ]]; then
  docker buildx ls | grep "${BUILDX_INSTANCE}" || docker buildx create --name="${BUILDX_INSTANCE}" --platform=linux/amd64,linux/arm64
  docker buildx build --builder "${BUILDX_INSTANCE}" --platform linux/amd64,linux/arm64 -f "${DOCKERFILE}" -t "${IMAGE}" --load .
  docker buildx rm "${BUILDX_INSTANCE}"
else
  docker build -f "${DOCKERFILE}" -t "${IMAGE}" .
fi

echo Built "${IMAGE}"
docker image save "${IMAGE}" -o ./build/artifacts/backup-restore-operator.img
