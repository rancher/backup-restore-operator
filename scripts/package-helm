#!/bin/bash

set -e

TMP_HIP_15="/tmp/hip15.yaml"
RANCHER_BACKUP_VALUES="charts/rancher-backup/values.yaml"
RANCHER_BACKUP_CHART="charts/rancher-backup/Chart.yaml"
RANCHER_BACKUP_CRD_CHART="charts/rancher-backup-crd/Chart.yaml"

function cleanup-hip-15-annotations() {
  rm "${TMP_HIP_15}"
}

trap cleanup-hip-15-annotations EXIT

function add-hip-15-annotations() {
  grep "%" "${RANCHER_BACKUP_VALUES}" -v |
    yq '{
  "annotations": {
    "helm.sh/images": [
      {
        "name": "backup-restore-operator",
        "image": "rancher/backup-restore-operator:%TAG%"
      },
      {
        "name": .global.kubectl.repository | split("/")[1],
        "image": .global.kubectl.repository + ":" + .global.kubectl.tag
      }
    ]
  }
}' >"${TMP_HIP_15}"
}

function edit-charts() {
  perl -i -pe "
    s/^version:.*/version: ${1}/;
    s/^appVersion:.*/appVersion: \"${2}\"/;
    s@catalog.cattle.io/upstream-version:.*@catalog.cattle.io/upstream-version: ${1}@;
" "build/${RANCHER_BACKUP_CHART}"

  perl -i -pe "s/%TAG%/${2}/;" "build/${RANCHER_BACKUP_VALUES}"

  perl -i -pe "
    s/^version:.*/version: ${1}/;
    s/^appVersion:.*/appVersion: \"${2}\"/;
" "build/${RANCHER_BACKUP_CRD_CHART}"

  perl -i -pe "s/%TAG%/${2}/;" "${TMP_HIP_15}"
  yq -i ". *= load(\"${TMP_HIP_15}\")" "build/${RANCHER_BACKUP_CHART}"
  perl -i -pe "s@helm.sh/images:@helm.sh/images: |@;" "build/${RANCHER_BACKUP_CHART}"
}

function package-charts() {
  helm package --debug -d ./build/artifacts ./build/charts/rancher-backup
  helm package --debug -d ./build/artifacts ./build/charts/rancher-backup-crd
}

if ! hash helm 2>/dev/null; then
  echo "Helm is not installed"
  exit 1
fi

cd "$(dirname "$0")/.."
source ./scripts/version

rm -rf build/charts build/artifacts
mkdir -p build/artifacts
cp -rf charts build/

add-hip-15-annotations
edit-charts "${HELM_CHART_VERSION}" "${HELM_IMAGE_TAG}"

if ! package-charts; then
  echo "Packaging the BRO charts failed!"
fi
